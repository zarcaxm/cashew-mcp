# Backup folder — MCP picks the most recent .sql / .sqlite / .db file here
CASHEW_BACKUP_DIR=D:/Documents/Cashew Backups

# Optional: override with a specific file or folder (takes precedence over CASHEW_BACKUP_DIR)
# CASHEW_DB=D:/Documents/Cashew Backups/my-export.sql

# Optional: tune the finance profile used by decision-support tools
# CASHEW_SPENDABLE_WALLETS=Checkings,Banco
# CASHEW_RESERVE_WALLETS=Savings,Emergency Fund,Savings-Rev,Credit Card,Owing
# CASHEW_CORRECTION_CATEGORIES=Balance Correction,Transferencia
# CASHEW_IGNORED_BUDGETS=Unaccounted
